###The following is a number of commands that allow the computation of (numerical) syzygies.\
###The computations rely on passing completely into the realm of linear algebra and using SVD to approximate rank\
\
#monomial exponentiation\
def monexp(vrs,expn):\
    return(product([v[0]^(v[1]) for v in zip(vrs,expn)]))\
    \
#Get basis for polynomials homogeneous of degree d\
def poly_basis(deg,vrs):\
    num=len(vrs);\
    basisvecs = [list(m) for m in IntegerVectors(deg,num)];\
    return([monexp(vrs,expn) for expn in basisvecs])\
\
#get coefficients of polynomial in preferred order\
def coeffs(F,basis):\
    return([F.coefficient(m) for m in basis])\
\
#Given a matrix of polynomials, convert each polynomial entry into a coefficient vector (column)\
def coeffs_mat(M,Degs,vrs):\
    return(block_matrix([[matrix(zip(*[coeffs(M[i,j],poly_basis(Degs[i,j],vrs)) for j in range(0,M.ncols())]))] for i in range(0,M.nrows())]))\
\
#Given a list with polynomial entries, return a list of those polynomials multiplied by all monomials of a given degree (degree may vary for each polynomial)\
def mon_mult(PolyList,DegreeDeficits,vrs):\
    return(flatten([[expand(m*PolyList[i]) for m in poly_basis(DegreeDeficits[i],vrs)] for i in range(0,len(PolyList))]))\
\
#Given a matrix with polynomial entries, return a matrix whose rows are multiplied by all monomials of a given degree (output of previous function)\
def mon_mult_matrix(PolyMat,DegreeDeficits,vrs):\
    return(matrix([mon_mult(rw,DegreeDeficits,vrs) for rw in PolyMat.rows()]))\
\
#Index selection functions\
def ind_select_less(L,tol):\
    iList = [i for i,x in enumerate(L) if x<tol]\
    if len(iList)==0:\
        return(len(L))\
    else:\
        return(iList[0])\
