#Take the derivative of a monomial x^a with respect to y^b and evaluate at a point p\
def monomial_derivative_evaluation(a,b,p):\
    a = vector(a);\
    b = vector(b);\
    d = a-b;\
    neg_c = false;\
    ind = 0;\
    while not neg_c and ind<len(d):\
        if d[ind]<0:\
            neg_c = true\
        ind = ind+1\
    if neg_c:\
        return(0)\
    else:\
        return(product([factorial(a[i])/factorial(a[i]-b[i])*p[i]^(d[i]) for i in range(0,len(a))]))\
        \
#Matrix whose kernel consists of all polynomials of degree deg which vanish to order ord at points in ptlist\
def fat_matrix(deg,ord,ptlist):\
    num_vars = len(ptlist[0]);\
    monexp = IntegerVectors(deg,num_vars);\
    mat_rows = [];\
    for i in range(0,len(ptlist)):\
        p = ptlist[i];\
        deriv_mons = IntegerVectors(ord[i],num_vars);\
        for m in deriv_mons:\
            mat_rows=mat_rows+[[monomial_derivative_evaluation(n,m,p) for n in monexp]];\
    return(matrix(mat_rows))\
                    \
#Take matrix with columns consisting of coefficients and turn it into polynomials\
def vec_to_poly(coeff,deg,vrs,row=true):\
    BS = matrix([[product([(vrs[i])^(a[i]) for i in range(0,len(a))]) for a in IntegerVectors(deg,len(vrs))]]);\
    if coeff.nrows()==0 or coeff.ncols()==0:\
        return(0)\
    if row:\
        return(coeff*(BS.transpose()))\
    else:\
        return(BS*coeff)\
\
#Basis for polynomials of degree deg that vanish to order ord at points in ptlist\
def fat_ideal(deg,ord,ptlist,vrs=None,poly_form=true):\
    FM = fat_matrix(deg,ord,ptlist);\
    K = matrix((fat_matrix(deg,ord,ptlist)).right_kernel().basis());\
    if poly_form:\
        return(vec_to_poly(K,deg,vrs))\
    else:\
        return(K)\
