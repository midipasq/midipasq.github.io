#Convert a matrix of coefficients (assumed column vectors) back into a matrix of polynomials\
def coeff_to_poly(cfMat,Degs,vrs):\
    pMat = [];\
    for c in range(0,cfMat.ncols()):\
        indx = 0;\
        pCol = [];\
        for cnt in range(0,Degs.nrows()):\
            mns = poly_basis(Degs[cnt,c],vrs);\
            cntln = len(mns);\
            poly=0;\
            for incnt in range(0,cntln):\
                poly = poly+vec[indx]*mns[incnt];\
                indx = indx+1;\
            pCol=pCol+[poly];\
        pMat = pMat+[pCol];\
    return(transpose(matrix(pMat)))\
\
#Convert a column relation back into a polynomial relation, given DegreeDeficits\
def rel_to_poly(rMat,DegreeDeficits,vrs):\
        relMat = [];\
        for vec in rMat.columns():\
            indx = 0;\
            relCol = [];\
            for cnt in range(0,len(DegreeDeficits)):\
                mns = poly_basis(DegreeDeficits[cnt],vrs);\
                cntln = len(mns);\
                poly=0;\
                for incnt in range(0,cntln):\
                    poly = poly+vec[indx]*mns[incnt];\
                    indx = indx+1;\
                relCol=relCol+[poly];\
            relMat=relMat+[relCol];\
        return(transpose(matrix(relMat)))\
\
#NUMERICAL syzygies of a list of homogeneous polynomials in a specific degree\
def num_syz(PolyList,DegreeDeficits,deg,vrs,as_poly=false,tol=10^(-12)):\
    bs = poly_basis(deg,vrs);\
    exp_mons = mon_mult(PolyList,DegreeDeficits,vrs);\
    cfMat = matrix([coeffs(F,bs) for F in exp_mons]);\
    [U,S,V] = cfMat.change_ring(CDF).SVD();\
    mn = min(S.ncols(),S.nrows());\
    singVals = [S[i,i] for i in range(0,mn)];\
    IND = ind_select_less(singVals,tol);\
    num_ker = conjugate(U[range(0,U.nrows()),range(IND,U.ncols())])\
    if as_poly:\
        return(rel_to_poly(num_ker,DegreeDeficits,vrs))\
    else:\
        return(num_ker)\
\
#Numerical intersection of column spaces (same ambient!).  Assumes that matrices have independent columns.\
def num_intersect(L,tol=10^(-10)):\
    #L is a list of matrices; we will return the numerical intersection of the column spaces\
    ocmps = [orth_comp(M) for M in L];\
    return(orth_comp(block_matrix([ocmps]),indep_cols=false,tol=tol))\
\
#Numerical orthogonal complement of a column space with respect to another\
def orth_comp_subspace(MAT1,MAT2,tol=10^(-12)):\
    #Take orthogonal complement of col(MAT2) with respect to col(MAT1)\
    [U1,S1,V1] = MAT1.change_ring(CDF).SVD();\
    mn1 = min(S1.ncols(),S1.nrows());\
    singVals1 = [S1[i,i] for i in range(0,mn1)];\
    IND1 = ind_select_less(singVals1,tol);\
    O1 = U1[range(0,U1.nrows()),range(0,IND1)];\
    ProjM = O1*(O1.conjugate_transpose());\
    ID = matrix.identity(ProjM.ncols());\
    Orth1 = (ID-ProjM)*MAT2;\
    [U,S,V] = Orth1.change_ring(CDF).SVD();\
    mn = min(S.ncols(),S.nrows());\
    singVals = [S[i,i] for i in range(0,mn)];\
    IND = ind_select_less(singVals,tol);\
    return(U[range(0,U.nrows()),range(0,IND)])\
\
#Numerical orthogonal complement of column space\
def orth_comp(MAT,indep_cols=true,tol=10^(-12)):\
    [U,S,V] = MAT.change_ring(CDF).SVD();\
    if indep_cols:\
        r = MAT.ncols();\
        return( (U[range(0,U.nrows()),range(r,U.ncols())]).conjugate())\
    else:\
        singVals = [S[i,i] for i in range(0,min(S.ncols(),S.nrows()))];\
        IND = ind_select_less(singVals,tol);\
        return((U[range(0,U.nrows()),range(IND,U.ncols())]).conjugate())            \
        \
#NUMERICAL syzygies of a matrix of polynomials with homogeneous entries\
def num_syz_matrix(PolyMat,DegreeDeficits,row_degs,vrs,tol=10^(-12),as_poly=true):\
    row_kers = [num_syz(list(PolyMat.row(i)),DegreeDeficits,row_degs[i],vrs,tol=tol) for i in range(0,PolyMat.nrows())];\
    num_ker=num_intersect(row_kers,tol=tol)\
    if as_poly:\
        return(rel_to_poly(num_ker,DegreeDeficits,vrs))\
    else:\
        return(num_ker)\
}